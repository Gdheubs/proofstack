# Documentation only. Set real values in the workspace/deployment secret store.
# DATABASE_URL is provided by the managed PostgreSQL database.
DATABASE_URL=
PORT=
NODE_ENV=development
LOG_LEVEL=info
# Exact origins, comma-separated, with no path or trailing slash. Empty denies cross-origin.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
# Explicit trusted reverse-proxy IPs/CIDRs only; blank ignores forwarded IPs.
TRUST_PROXY_CIDRS=
# Pauses product writes and new worker claims; authentication remains available.
MAINTENANCE_MODE=false

# Identity; server-side only. See docs/identity.md. Never prefix secrets NEXT_PUBLIC_.
AUTH_APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate a cryptographically random value of at least 32 characters.
SESSION_SECRET=
# Enable only after testing actual provider delivery/entitlement.
AUTH_EMAIL_SMTP_READY=false
AUTH_PHONE_MFA_READY=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
SUPABASE_SMS_HOOK_SECRET=

# Replit App Storage: private bucket directory provisioned by Replit.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional Replit AI integration. Missing values disable AI, not the API.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
COMMUNITY_AI_MODEL=gpt-5.6-luna

# Optional Next.js same-origin proxy for local/standalone use.
# Set before build (and dev). Leave unset when Replit routes /api itself.
API_INTERNAL_ORIGIN=

# Optional native Git hosting: installed Git + private durable POSIX volume.
# Keep unset on ephemeral/autoscale filesystems. See docs/repositories.md.
REPOSITORY_ROOT=

# Optional Phase 6 durable jobs. Run a separate always-on intelligence worker.
# Fixed caps: 20 jobs/user/day, 3 AI plans/user/day, 100 AI plans/global/day.
INTELLIGENCE_ENABLED=false
# Required only for optional AI plans; choose a JSON-mode model supported by your provider.
INTELLIGENCE_AI_MODEL=
# Optional current model rates, USD per million tokens. Blank means cost unknown.
INTELLIGENCE_INPUT_USD_PER_MILLION=
INTELLIGENCE_OUTPUT_USD_PER_MILLION=
