# Documentation only. Set real values in the workspace/deployment secret store.
# DATABASE_URL is provided by the managed PostgreSQL database.
DATABASE_URL=
PORT=
NODE_ENV=development
LOG_LEVEL=info
# Optional API listener; the validated local launcher always uses loopback.
BIND_HOST=0.0.0.0
# Exact origins, comma-separated, with no path or trailing slash. Empty denies cross-origin.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
# Explicit trusted reverse-proxy IPs/CIDRs only; blank ignores forwarded IPs.
TRUST_PROXY_CIDRS=
# Pauses product writes and new worker claims; authentication remains available.
MAINTENANCE_MODE=false

# Identity; server-side only. See docs/identity.md and docs/firebase-auth.md.
# Never prefix server secrets NEXT_PUBLIC_. Supabase remains the default.
AUTH_PROVIDER=supabase
AUTH_APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate a cryptographically random value of at least 32 characters.
SESSION_SECRET=
# Enable only after testing actual provider delivery/entitlement.
AUTH_EMAIL_SMTP_READY=false
AUTH_PHONE_MFA_READY=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
SUPABASE_SMS_HOOK_SECRET=

# Optional Firebase social identity mode: set AUTH_PROVIDER=firebase explicitly.
# ADC is server-only: use workload identity or an external service-account file.
# Never put credential JSON/key contents in this file or browser bundles.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Public web config file (allowlisted fields only), OR the individual fields below.
FIREBASE_WEB_CONFIG_FILE=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
# Declare ready only after actual provider/authorized-domain setup and live sign-in.
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_GITHUB_ENABLED=false
# Firebase MFA enrollment/management/recovery remain pending, regardless of flags.

# Legacy Replit object storage settings. Uploads are unavailable on Vercel/Render
# until the object storage adapter is replaced with a supported provider.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional OpenAI-compatible endpoint and API key for AI features.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
COMMUNITY_AI_MODEL=gpt-5.6-luna

# Optional Next.js same-origin proxy for local/standalone use.
# Set before build so the frontend can proxy /api to the Express service.
API_INTERNAL_ORIGIN=

# Optional native Git hosting: installed Git + private durable POSIX volume.
# Keep unset on ephemeral/autoscale filesystems. See docs/repositories.md.
REPOSITORY_ROOT=

# Optional Phase 6 durable jobs. Run a separate always-on intelligence worker.
# Fixed caps: 20 jobs/user/day, 3 AI plans/user/day, 100 AI plans/global/day.
INTELLIGENCE_ENABLED=false
# Required only for optional AI plans; choose a JSON-mode model supported by your provider.
INTELLIGENCE_AI_MODEL=
# Optional current model rates, USD per million tokens. Blank means cost unknown.
INTELLIGENCE_INPUT_USD_PER_MILLION=
INTELLIGENCE_OUTPUT_USD_PER_MILLION=

# Local full-stack launcher only: copy this template to ignored .env.local.
# Local-only DATABASE_URL, pre-applied migrations and an exact HTTPS origin are required.
# Never point the launcher at production or replace a live session key for this audit.
WEB_PORT=3011
API_PORT=8089
SESSION_SECRET_FILE=
DEV_TLS_KEY_FILE=
DEV_TLS_CERT_FILE=
