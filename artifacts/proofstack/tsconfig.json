{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", "app/**/*", "components/**/*", "hooks/**/*", "lib/**/*", "proxy.ts", "next.config.ts", "src/components/**/*", "src/hooks/**/*", "src/lib/**/*", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["./src/components/ui/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/hooks/use-toast": ["./src/hooks/use-toast.ts"],
      "@/hooks/use-mobile": ["./src/hooks/use-mobile.tsx"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
