// Cloudflare Workers deployment of the Next.js frontend via OpenNext.
// Runtime settings (not secrets) live here; set PROXY_SHARED_SECRET with
// `wrangler secret put PROXY_SHARED_SECRET` or in the dashboard, and
// API_INTERNAL_ORIGIN as a *build* variable (Next bakes rewrites at build time).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofstack-web",
  // worker.ts wraps the generated .open-next/worker.js (see that file).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: the Worker may only fetch public addresses,
  // so the /api rewrite cannot be pointed at internal networks.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Off: keep_names adds __name() calls to functions that next-themes turns
  // into an inline script, which then fails in the browser.
  "keep_names": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "TRUSTED_CLIENT_IP_HEADER": "cf-connecting-ip",
  },
}
